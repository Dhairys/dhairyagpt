  },
  "shortcuts": [
    {
      "name": "New chat",
      "short_name": "New chat",
      "description": "Start a fresh conversation",
      "url": "/?new=1",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
